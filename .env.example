# NOVA Player Environment Configuration

# Desktop Host Port & Sidecar
NOVA_AI_SERVICE_URL=http://127.0.0.1:8765
NOVA_ENABLE_LOCAL_AI=true
NOVA_ENABLE_CLOUD_AI=false

# Optional Cloud AI Providers (Never hardcoded in client binaries)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Local Model Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
FASTER_WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# Cache Directories
NOVA_CACHE_DIR=./data/cache
NOVA_THUMBNAILS_DIR=./data/cache/thumbnails
