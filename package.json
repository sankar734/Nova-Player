{
  "name": "nova-player",
  "version": "1.0.0",
  "private": true,
  "description": "NOVA PLAYER - AI-Powered Universal Multimedia Player & Video Intelligence Platform",
  "workspaces": [
    "packages/*",
    "media-engine",
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=@nova/desktop",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b --force"
  },
  "keywords": [
    "media-player",
    "ai",
    "tauri",
    "video-intelligence",
    "ffmpeg",
    "faster-whisper",
    "rag"
  ],
  "author": "NOVA Team",
  "license": "MIT"
}
